# Скопіюйте у .env і заповніть. .env у git не потрапляє.

# --- База ---
POSTGRES_USER=jobtrack
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jobtrack
DATABASE_URL=postgresql+asyncpg://jobtrack:change-me@db:5432/jobtrack

# --- API ---
# Ключ для синхронізації статусів із браузера (E1). Будь-який довгий рядок.
SYNC_TOKEN=change-me-to-a-long-random-string
# Сторінки, з яких браузеру дозволено звертатися сюди (через кому).
# Потрібне для збору статусів: скрипт працює на сторінці майданчика.
CORS_ORIGINS=https://djinni.co,https://jobs.dou.ua,https://dou.ua,https://www.linkedin.com

# --- Збір вакансій (E2+) ---
# Контакт у User-Agent — вимога ввічливого збору: власник сайту має бачити, хто ходить.
SCRAPER_CONTACT=you@example.com

# --- Telegram (E4) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Telegram: читання каналів з вакансіями (E6) ---
# Облікові дані застосунку з my.telegram.org -> API development tools.
# Це НЕ токен бота: бот не бачить каналів, у яких не перебуває, і не може
# читати історію. Для читання потрібен обліковий запис користувача.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Файл сесії створюється при першому вході і рівноцінний доступу до акаунта.
TELEGRAM_SESSION=data/jobtrack.session
